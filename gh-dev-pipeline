#!/usr/bin/env bash
# gh CLI extension entry point for dev-pipeline (GitHub Copilot version).
# Usage: gh dev-pipeline [target-dir]   (default target-dir: .)
#
# Installing copies the current definitions and never deletes files the
# installer does not own. .github/agents/ and .github/prompts/ commonly hold the
# project's own agents and prompts, and "not shipped by dev-pipeline" does not
# mean "stale".
#
# The one exception is an agent this repo used to ship and has since retired
# (e.g. code-reviewer, replaced by the four per-aspect reviewers). Left behind,
# its stale description still advertises a phase that no longer exists and it
# can be picked from the agent list by mistake. Such files are removed only when
# the name is in RETIRED_AGENTS and the file still carries the generated-file
# marker, so a project's own file that happens to share the name is kept.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR/.git" ]; then
  echo "error: $TARGET_DIR is not a git repository root (no .git found)" >&2
  exit 1
fi

mkdir -p "$TARGET_DIR/.github/agents" "$TARGET_DIR/.github/prompts"

# Agent files this repo used to ship and no longer does. Add a name here when
# retiring an agent; never list a name that is still shipped.
RETIRED_AGENTS=(
  code-reviewer.agent.md
)
GENERATED_MARKER='<!-- 自動生成ファイル:'

for base in "${RETIRED_AGENTS[@]}"; do
  dst="$TARGET_DIR/.github/agents/$base"
  [ -e "$dst" ] || continue
  if grep -qF -- "$GENERATED_MARKER" "$dst"; then
    rm -- "$dst"
    echo "removed retired: $dst"
  else
    echo "note: kept $dst — dev-pipeline no longer ships an agent by this name, but this file" >&2
    echo "      has no dev-pipeline generated-file marker, so it was left alone. Delete it" >&2
    echo "      yourself if it is a leftover from an old dev-pipeline install." >&2
  fi
done

cp "$SCRIPT_DIR/copilot/agents/"*.agent.md "$TARGET_DIR/.github/agents/"
cp "$SCRIPT_DIR/copilot/prompts/"*.prompt.md "$TARGET_DIR/.github/prompts/"

echo "Installed dev-pipeline (Copilot) into $TARGET_DIR/.github/agents and $TARGET_DIR/.github/prompts"

# The pipeline reads two project-side files, pipeline-config.md and
# lessons-learned.md. For this install they live next to the agent definitions
# in .github/agents/ (the Claude Code version uses .claude/, an install under
# .agents/ uses .agents/). The old location was docs/; point out files left
# there so the config is not silently ignored and the lessons log does not split.
CONFIG_DIR="$TARGET_DIR/.github/agents"
for f in pipeline-config.md lessons-learned.md; do
  if [ -f "$TARGET_DIR/docs/$f" ] && [ ! -f "$CONFIG_DIR/$f" ]; then
    echo ""
    echo "note: found $TARGET_DIR/docs/$f — the pipeline now reads it from $CONFIG_DIR/."
    echo "      Move it there (from $TARGET_DIR):"
    echo "        git mv docs/$f .github/agents/$f"
  fi
done
if [ ! -f "$CONFIG_DIR/pipeline-config.md" ] && [ ! -f "$TARGET_DIR/docs/pipeline-config.md" ]; then
  echo ""
  echo "note: no $CONFIG_DIR/pipeline-config.md found (optional but recommended)."
  echo "      The pipeline reads the stack config from .github/agents/pipeline-config.md and"
  echo "      appends lessons learned to .github/agents/lessons-learned.md."
  echo "      Start from the template and edit it for this project's stack:"
  echo "        cp $SCRIPT_DIR/templates/pipeline-config.md $CONFIG_DIR/pipeline-config.md"
fi
